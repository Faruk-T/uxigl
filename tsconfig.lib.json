{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "outDir": "./dist/lib/types",
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/vite-env.d.ts",
    "src/index.ts",
    "src/components/**/*",
    "src/core/**/*",
    "src/hooks/**/*",
    "src/providers/**/*"
  ]
}
